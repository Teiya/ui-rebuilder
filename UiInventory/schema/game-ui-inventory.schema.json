{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ui-rebuilder:schema:game-ui-inventory:v1",
  "title": "Game UI Inventory",
  "description": "Portable schema for weakly labeled UI cases extracted from any project-local source such as scenes, prefabs, screenshots, or design exports.",
  "type": "object",
  "required": [
    "schema",
    "sceneName",
    "scenePath",
    "theme",
    "exportedAtUtc",
    "sourceRootPath",
    "panelCount",
    "panels"
  ],
  "properties": {
    "schema": {
      "const": "game-ui-inventory/v1"
    },
    "sceneName": {
      "type": "string"
    },
    "scenePath": {
      "type": "string"
    },
    "theme": {
      "type": "string"
    },
    "exportedAtUtc": {
      "type": "string",
      "format": "date-time"
    },
    "sourceRootPath": {
      "type": "string"
    },
    "panelCount": {
      "type": "integer",
      "minimum": 0
    },
    "panelTypeSummary": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/tagCount"
      }
    },
    "semanticTagSummary": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/tagCount"
      }
    },
    "componentTypeSummary": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/tagCount"
      }
    },
    "panels": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/panel"
      }
    }
  },
  "$defs": {
    "tagCount": {
      "type": "object",
      "required": [
        "name",
        "count"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "panel": {
      "type": "object",
      "required": [
        "id",
        "name",
        "path",
        "theme",
        "screenType",
        "panelKind",
        "tags",
        "directChildNames",
        "directChildTags",
        "compositionPatterns",
        "directChildCount",
        "descendantCount",
        "buttonCount",
        "textCount",
        "imageCount",
        "inputCount",
        "toggleCount",
        "sliderCount",
        "layoutGroupCount",
        "particleCount",
        "nodes"
      ],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "path": { "type": "string" },
        "theme": { "type": "string" },
        "screenType": { "type": "string" },
        "panelKind": { "type": "string" },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "directChildNames": {
          "type": "array",
          "items": { "type": "string" }
        },
        "directChildTags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "compositionPatterns": {
          "type": "array",
          "items": { "type": "string" }
        },
        "directChildCount": {
          "type": "integer",
          "minimum": 0
        },
        "descendantCount": {
          "type": "integer",
          "minimum": 0
        },
        "buttonCount": {
          "type": "integer",
          "minimum": 0
        },
        "textCount": {
          "type": "integer",
          "minimum": 0
        },
        "imageCount": {
          "type": "integer",
          "minimum": 0
        },
        "inputCount": {
          "type": "integer",
          "minimum": 0
        },
        "toggleCount": {
          "type": "integer",
          "minimum": 0
        },
        "sliderCount": {
          "type": "integer",
          "minimum": 0
        },
        "layoutGroupCount": {
          "type": "integer",
          "minimum": 0
        },
        "particleCount": {
          "type": "integer",
          "minimum": 0
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        }
      },
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "required": [
        "name",
        "path",
        "depth",
        "childCount",
        "componentTypes",
        "tags",
        "spriteName",
        "textPreview"
      ],
      "properties": {
        "name": { "type": "string" },
        "path": { "type": "string" },
        "depth": {
          "type": "integer",
          "minimum": 0
        },
        "childCount": {
          "type": "integer",
          "minimum": 0
        },
        "componentTypes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "spriteName": {
          "type": "string"
        },
        "textPreview": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
