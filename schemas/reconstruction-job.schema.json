{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ui-rebuilder:schema:reconstruction-job:v1",
  "title": "UI Rebuilder reconstruction job",
  "type": "object",
  "required": ["schemaVersion", "id", "reference", "styleProfile", "layout"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "name": {"type": "string", "minLength": 1},
    "reference": {
      "type": "object",
      "required": ["path"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "screenBox": {
          "type": "array",
          "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}, {"type": "number"}],
          "items": false
        }
      },
      "additionalProperties": false
    },
    "styleProfile": {"type": "string", "minLength": 1},
    "layout": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "path"],
          "properties": {
            "kind": {"const": "layout-authority"},
            "path": {"type": "string", "minLength": 1},
            "screenNode": {"type": "string"}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "screen", "nodes"],
          "properties": {
            "kind": {"const": "inline"},
            "screen": {"$ref": "#/$defs/inlineNode"},
            "nodes": {"type": "array", "items": {"$ref": "#/$defs/inlineNode"}}
          },
          "additionalProperties": false
        }
      ]
    },
    "textOverrides": {"type": "object", "additionalProperties": {"type": "string"}},
    "nodeOverrides": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "text": {"type": "string"},
          "visible": {"type": "boolean"},
          "style": {"type": "object"},
          "layout": {"type": "object"}
        },
        "additionalProperties": true
      }
    },
    "extraNodes": {
      "type": "array",
      "items": {"$ref": "#/$defs/inlineNode"}
    },
    "textFallback": {
      "type": "object",
      "required": ["fontPath"],
      "properties": {
        "enabled": {"type": "boolean"},
        "fontPath": {"type": "string", "minLength": 1},
        "fontFamily": {"type": "string"},
        "hideEditableTextInPreview": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "method"],
        "anyOf": [
          {"required": ["sourceBox"]},
          {"required": ["sourcePath"]}
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "sourcePath": {"type": "string", "minLength": 1},
          "sourceBox": {
            "type": "array",
            "prefixItems": [{"type": "integer"}, {"type": "integer"}, {"type": "integer"}, {"type": "integer"}],
            "items": false
          },
          "method": {"enum": ["extracted", "repaired", "generated", "vector", "runtime"]},
          "role": {"type": "string"},
          "targetNode": {"type": "string", "minLength": 1},
          "targetNodes": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "targetSize": {
            "type": "array",
            "prefixItems": [{"type": "integer", "minimum": 1}, {"type": "integer", "minimum": 1}],
            "items": false
          },
          "trimTransparent": {"type": "boolean"},
          "alphaRequired": {"type": "boolean"},
          "opacity": {"type": "number", "minimum": 0, "maximum": 1},
          "backgroundDependency": {"type": "string"},
          "scaling": {"enum": ["none", "uniform", "nine-slice", "tile"]},
          "borderLTRB": {
            "type": "array",
            "prefixItems": [{"type": "integer"}, {"type": "integer"}, {"type": "integer"}, {"type": "integer"}],
            "items": false
          }
        },
        "additionalProperties": true
      }
    },
    "outputs": {
      "type": "array",
      "items": {"enum": ["package", "openpencil-fig"]},
      "uniqueItems": true
    }
  },
  "$defs": {
    "inlineNode": {
      "type": "object",
      "required": ["name", "type", "bounds"],
      "properties": {
        "id": {"type": "string"},
        "name": {"type": "string", "minLength": 1},
        "type": {"enum": ["frame", "component", "instance", "rectangle", "ellipse", "text", "image"]},
        "parent": {"type": ["string", "null"]},
        "bounds": {
          "type": "array",
          "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number", "exclusiveMinimum": 0}, {"type": "number", "exclusiveMinimum": 0}],
          "items": false
        },
        "text": {"type": "string"},
        "role": {"type": "string"},
        "dynamic": {"type": "boolean"},
        "layoutMode": {"enum": ["NONE", "HORIZONTAL", "VERTICAL"]}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
