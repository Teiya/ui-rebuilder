{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ui-rebuilder:schema:style-profile:v1",
  "title": "UI Rebuilder consumer style profile",
  "type": "object",
  "required": ["schemaVersion", "id", "status", "tokens", "reconstruction"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "provisional", "approved"]},
    "tokens": {
      "type": "object",
      "required": ["colors", "spacing", "typography"],
      "properties": {
        "colors": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$"}},
        "spacing": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0}},
        "typography": {"type": "object", "additionalProperties": true},
        "radius": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0}},
        "stroke": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0}}
      },
      "additionalProperties": true
    },
    "reconstruction": {
      "type": "object",
      "required": ["methodPriority", "dynamicContent"],
      "properties": {
        "methodPriority": {"type": "array", "items": {"enum": ["extract", "repair", "reuse", "controlled-generation", "one-shot-generation"]}},
        "dynamicContent": {"type": "array", "items": {"type": "string"}},
        "forbidden": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
